Attribute VB_Name = "Установка"
Option Explicit

' ═══════════════════════════════════════════════════════════════════════
'  Разовый установщик: импортирует все модули пульта одним запуском,
'  а не двадцатью двумя ручными «File → Import File…».
'
'  Как пользоваться (это и есть способ первый шага 3 из ИНСТРУКЦИИ):
'   1. Alt+F11 → File → Import File… → выбрать этот файл, «Установка.bas»,
'      из папки «Для_импорта» (он там же, среди остальных модулей).
'   2. В редакторе VBA нажать F5, выбрать «УстановитьВсё», Run.
'   3. Программа спросит папку «Для_импорта» — путь туда, где лежит и
'      этот файл, — и сделает всё сама: импортирует остальные 22 модуля,
'      вставит код листа «ЭтаКнига», построит пульт.
'
'  ОБНОВЛЕНИЕ МОДУЛЕЙ — ЭТО ТОТ ЖЕ САМЫЙ ЗАПУСК. Модуль не удаляет себя
'  после установки, он остаётся в книге именно для этого: пришли новые
'  файлы — F5 → «УстановитьВсё», указать новую папку «Для_импорта», и
'  все модули заменятся разом. Уже существующий модуль с тем же именем
'  сначала удаляется и ставится заново — старый код не накапливается
'  рядом с новым, разбирать по одному, что изменилось, не нужно.
'
'  Обновлять надо ТУ КНИГУ, В КОТОРОЙ РАБОТАЕТЕ. Вкладка «ЛНК» на ленте
'  живёт не в коде, а в самом файле книги: импорт модулей её не создаёт
'  и не переносит. Если вам прислали книгу программы с лентой — обновляйте
'  модули в ней, а прежнюю уберите, иначе вкладки не будет.
'
'  После установки показывается номер версии кода и, если он разошёлся с
'  номером в настройках книги данных, об этом говорится прямо.
'
'  Нужна одна настройка Excel, включаемая один раз на компьютере, без
'  прав администратора — это личная настройка Excel, а не системная:
'  Файл → Параметры → Центр управления безопасностью → Параметры центра
'  управления безопасностью → Параметры макросов → «Доверять доступ к
'  объектной модели проектов VBA». Без неё Excel не даёт программе
'  трогать код самой себя, и это доверие приходится дать явно — иначе
'  ниже будет понятное сообщение, а не непонятная ошибка 1004.
' ═══════════════════════════════════════════════════════════════════════

Private Const САМ_СЕБЯ As String = "Установка"
Private Const КОД_КНИГИ As String = "ЭтаКнига_код.txt"


Public Sub УстановитьВсё()
    Dim папка As String
    Dim импортировано As Long
    Dim пропущено As Long
    Dim отчёт As String

    If Not ЕстьДоступКVBA() Then
        MsgBox "Excel не даёт программно менять код проекта." & vbCrLf & vbCrLf & _
               "Включите один раз (без прав администратора):" & vbCrLf & _
               "Файл → Параметры → Центр управления безопасностью →" & vbCrLf & _
               "Параметры центра управления безопасностью → Параметры макросов →" & vbCrLf & _
               "«Доверять доступ к объектной модели проектов VBA»." & vbCrLf & vbCrLf & _
               "Дальше закройте и снова откройте книгу и повторите «УстановитьВсё»." & _
               vbCrLf & vbCrLf & _
               "Не включается (например, режим запрещён политикой безопасности) — " & _
               "тогда без обид, импортируйте по одному через File → Import File…, " & _
               "список файлов есть в ИНСТРУКЦИИ, шаг 3, способ второй.", _
               vbExclamation, "Установка"
        Exit Sub
    End If

    папка = СпроситьПапку()
    If папка = "" Then Exit Sub

    отчёт = ИмпортироватьМодули(папка, импортировано, пропущено)
    отчёт = отчёт & vbCrLf & ВставитьКодКниги(папка)
    отчёт = отчёт & vbCrLf & ЛишниеМодули(папка)

    ' Раннее (при компиляции) обращение к modMenu.ПостроитьПульт здесь
    ' невозможно в принципе: пока этот модуль писался, modMenu ещё не
    ' существовал, и компилятор такой вызов не пропустил бы. Application.Run
    ' по имени резолвится во время выполнения, уже после импорта.
    On Error Resume Next
    Application.Run "modMenu.ПостроитьПульт"
    If Err.Number <> 0 Then
        отчёт = отчёт & vbCrLf & vbCrLf & "Пульт построить не удалось (" & Err.Description & _
                "). Постройте вручную: F5 → ПостроитьПульт (в модуле modMenu)."
        Err.Clear
    Else
        отчёт = отчёт & vbCrLf & vbCrLf & "Пульт построен — можно закрывать редактор VBA."
    End If
    On Error GoTo 0

    MsgBox "Готово." & vbCrLf & vbCrLf & _
           "Импортировано модулей: " & импортировано & _
           IIf(пропущено > 0, ", не удалось: " & пропущено, "") & "." & vbCrLf & _
           ОтчётОВерсии() & vbCrLf & отчёт, vbInformation, "Установка"
End Sub


' Какая версия кода теперь стоит. Зовётся через Application.Run: на
' момент написания этого модуля modConfig в книге ещё нет, и обычный
' вызов компилятор бы не пропустил. Настройку «Версия программы» из
' книги данных здесь не читаем нарочно — за ней открылась бы сама книга
' данных и могла бы показать своё сообщение поверх отчёта установки.
' Расхождение версий книга проверяет сама при открытии.
Private Function ОтчётОВерсии() As String
    Dim кода As String

    On Error Resume Next
    кода = CStr(Application.Run("modConfig.ВерсияКода"))
    On Error GoTo 0

    If кода = "" Then
        ОтчётОВерсии = "Версию кода определить не удалось — возможно, modConfig не встал."
    Else
        ОтчётОВерсии = "Версия кода: " & кода & "."
    End If
End Function


' Модули, оставшиеся от прежних версий: в книге есть, а в присланной
' папке их уже нет. Сами по себе они не мешали бы, но старый код может
' звать то, чего больше не существует, и книга перестанет собираться —
' а ошибка при этом покажет совсем не тот модуль, в котором дело.
' Удаляются только с согласия: вдруг это ваш собственный модуль.
Private Function ЛишниеМодули(папка As String) As String
    Dim имена As String
    Dim лишние As New Collection
    Dim компонент As Object
    Dim i As Long
    Dim перечень As String
    Dim файл As String

    имена = "|"
    файл = Dir(папка & "*.bas")
    Do While файл <> ""
        имена = имена & LCase$(Left$(файл, Len(файл) - 4)) & "|"
        файл = Dir
    Loop

    On Error Resume Next
    For i = 1 To ThisWorkbook.VBProject.VBComponents.Count
        Set компонент = ThisWorkbook.VBProject.VBComponents(i)
        ' 1 — обычный модуль. Листы и «ЭтаКнига» сюда не попадают.
        If компонент.Type = 1 Then
            If InStr(имена, "|" & LCase$(компонент.Name) & "|") = 0 Then
                If StrComp(компонент.Name, САМ_СЕБЯ, vbTextCompare) <> 0 Then
                    лишние.Add компонент.Name
                End If
            End If
        End If
    Next i
    On Error GoTo 0

    If лишние.Count = 0 Then Exit Function

    For i = 1 To лишние.Count
        перечень = перечень & vbCrLf & "  " & лишние(i)
    Next i

    If MsgBox("В книге остались модули, которых в присланной папке уже нет:" & _
              перечень & vbCrLf & vbCrLf & _
              "Обычно это модули прежних версий, переименованные или отменённые. " & _
              "Оставить их — книга может перестать собираться из-за вызовов того, " & _
              "чего больше нет." & vbCrLf & vbCrLf & "Удалить их?", _
              vbYesNo + vbQuestion, "Установка") <> vbYes Then
        ЛишниеМодули = "Лишние модули оставлены:" & перечень
        Exit Function
    End If

    On Error Resume Next
    For i = 1 To лишние.Count
        ThisWorkbook.VBProject.VBComponents.Remove _
            ThisWorkbook.VBProject.VBComponents(CStr(лишние(i)))
    Next i
    On Error GoTo 0
    ЛишниеМодули = "Удалены модули прежних версий:" & перечень
End Function


' Доступ к VBProject проверяется обращением к нему же: если запрещено,
' Excel поднимает ошибку 1004 ещё до попытки что-либо изменить, и
' ничего сломать не успевает.
Private Function ЕстьДоступКVBA() As Boolean
    Dim n As Long
    On Error Resume Next
    n = ThisWorkbook.VBProject.VBComponents.Count
    ЕстьДоступКVBA = (Err.Number = 0)
    Err.Clear
    On Error GoTo 0
End Function


' Угадать папку с модулями — не всегда рядом с книгой: книгу могли
' сохранить и на уровень выше (в корне «ЛНК», а не в «ЛНК\Макросы»,
' где реально лежит «Для_импорта»). Пробуем оба места, и только если
' ни одно не подошло — предлагаем то, что попроще объяснить в InputBox.
Private Function СпроситьПапку() As String
    Dim поУмолчанию As String
    Dim рядом As String
    Dim вПодпапке As String
    Dim папка As String

    рядом = ThisWorkbook.Path
    If Right$(рядом, 1) <> Application.PathSeparator Then рядом = рядом & Application.PathSeparator
    вПодпапке = рядом & "Макросы" & Application.PathSeparator & "Для_импорта"
    рядом = рядом & "Для_импорта"

    If Dir(рядом & Application.PathSeparator & "*.bas") <> "" Then
        поУмолчанию = рядом
    ElseIf Dir(вПодпапке & Application.PathSeparator & "*.bas") <> "" Then
        поУмолчанию = вПодпапке
    Else
        поУмолчанию = рядом          ' ни одно не подошло — спросим явно
    End If

    Do
        папка = InputBox("Папка с модулями (Для_импорта):", "Установка", поУмолчанию)
        If StrPtr(папка) = 0 Then Exit Function        ' нажали «Отмена»
        папка = Trim$(папка)
        If папка = "" Then Exit Function
        If Right$(папка, 1) <> Application.PathSeparator Then папка = папка & Application.PathSeparator
        If Dir(папка & "*.bas") = "" Then
            MsgBox "В этой папке нет ни одного .bas файла:" & vbCrLf & папка & vbCrLf & vbCrLf & _
                   "Укажите папку «Для_импорта» из присланного архива — тот же файл, " & _
                   "который вы только что импортировали, лежит там же.", _
                   vbExclamation, "Установка"
        Else
            СпроситьПапку = папка
            Exit Function
        End If
    Loop
End Function


' Импортирует все *.bas из папки, кроме себя самого — трогать во время
' исполнения модуль, из которого прямо сейчас выполняется код, нельзя,
' это не проверка вежливости, а гарантированный сбой.
'
' Если модуль с таким именем уже есть в книге, он сперва удаляется:
' так же можно накатить обновление модулей после правок, не разбирая
' руками, что именно изменилось — Excel не даёт «перезаписать» модуль
' импортом, только удалить старый и поставить новый.
Private Function ИмпортироватьМодули(папка As String, ByRef импортировано As Long, _
                                     ByRef пропущено As Long) As String
    Dim файлы As New Collection
    Dim файл As String
    Dim имя As String
    Dim ошибки As String
    Dim компонент As Object
    Dim i As Long

    ' Сначала полностью собрать список файлов и только потом его
    ' обрабатывать. Dir хранит состояние перебора сам в себе: раньше
    ' весь цикл был одним Do While с Dir на входе и на выходе, а внутри
    ' — вызовы VBComponents.Import/Remove. Прямых доказательств, что эти
    ' вызовы Dir не трогают, у меня нет — я не могу здесь запустить
    ' Excel и проверить. Раз нельзя проверить — не полагаемся: список
    ' собирается одним отдельным циклом Dir, а COM-вызовы идут по уже
    ' готовому списку, без единого Dir поблизости.
    файл = Dir(папка & "*.bas")
    Do While файл <> ""
        файлы.Add файл
        файл = Dir
    Loop

    For i = 1 To файлы.Count
        файл = CStr(файлы(i))
        имя = Left$(файл, Len(файл) - 4)
        If StrComp(имя, САМ_СЕБЯ, vbTextCompare) <> 0 Then
            On Error Resume Next
            Set компонент = ThisWorkbook.VBProject.VBComponents(имя)
            If Not компонент Is Nothing Then
                ThisWorkbook.VBProject.VBComponents.Remove компонент
            End If
            Set компонент = Nothing
            Err.Clear

            ThisWorkbook.VBProject.VBComponents.Import папка & файл
            If Err.Number = 0 Then
                импортировано = импортировано + 1
            Else
                пропущено = пропущено + 1
                ошибки = ошибки & vbCrLf & "  " & файл & ": " & Err.Description
                Err.Clear
            End If
            On Error GoTo 0
        End If
    Next i

    If ошибки <> "" Then ИмпортироватьМодули = "Не импортировались:" & ошибки
End Function


' ЭтаКнига_код.txt — не модуль, а код объекта «ЭтаКнига» (ThisWorkbook);
' файлом такое не импортируется, только вписывается в CodeModule уже
' существующего объекта. Запускать дважды безопасно: старый текст
' сначала стирается, а не дописывается — иначе Sub Workbook_Open
' задвоился бы, и книга перестала бы компилироваться.
Private Function ВставитьКодКниги(папка As String) As String
    Dim путь As String
    Dim код As String
    Dim модуль As Object

    путь = папка & КОД_КНИГИ
    If Dir(путь) = "" Then
        ВставитьКодКниги = "Файл " & КОД_КНИГИ & " не найден — код листа «ЭтаКнига» " & _
                            "придётся вставить руками, как в ИНСТРУКЦИИ, шаг 3, способ второй."
        Exit Function
    End If

    код = ПрочитатьФайл(путь)
    If код = "" Then
        ВставитьКодКниги = "Файл " & КОД_КНИГИ & " пуст или не читается — вставьте руками " & _
                            "(ИНСТРУКЦИЯ, шаг 3, способ второй)."
        Exit Function
    End If

    On Error GoTo Сбой
    Set модуль = ThisWorkbook.VBProject.VBComponents("ThisWorkbook").CodeModule
    If модуль.CountOfLines > 0 Then модуль.DeleteLines 1, модуль.CountOfLines
    модуль.AddFromString код
    ВставитьКодКниги = "Код листа «ЭтаКнига» вставлен."
    Exit Function

Сбой:
    ВставитьКодКниги = "Код листа «ЭтаКнига» вставить не удалось (" & Err.Description & _
                        ") — вставьте руками (ИНСТРУКЦИЯ, шаг 3, способ второй)."
End Function


' Обычное посимвольное чтение, без FileSystemObject: файл в cp1251,
' и Open…Input читает его в кодировке по умолчанию для системы — той
' же самой, в которой редактор VBA читает импортируемые .bas. Так у
' вставленного текста и у импортированных модулей одна судьба: либо
' оба читаются верно, либо оба одинаково нет, и причина видна сразу.
Private Function ПрочитатьФайл(путь As String) As String
    Dim n As Integer
    Dim строка As String
    Dim текст As String

    On Error GoTo Сбой
    n = FreeFile
    Open путь For Input As #n
    Do While Not EOF(n)
        Line Input #n, строка
        текст = текст & строка & vbCrLf
    Loop
    Close #n
    ПрочитатьФайл = текст
    Exit Function

Сбой:
    On Error Resume Next
    Close #n
    ПрочитатьФайл = ""
End Function
