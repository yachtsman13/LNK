<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui">
  <ribbon>
    <tabs>
      <tab id="tabLNK" label="ЛНК" insertBeforeMso="TabHome">

        <group id="grpZapis" label="Запись">
          <button id="btnNovaya" label="Новая запись" onAction="ЛентаНажата" tag="Новая запись в журнале"/>
          <button id="btnAkt" label="Новый акт" onAction="ЛентаНажата" tag="Открыть новый акт"/>
          <button id="btnKartochka" label="Карточка объекта" onAction="ЛентаНажата" tag="Карточка объекта"/>
          <button id="btnSohranitKartochku" label="Сохранить карточку" onAction="ЛентаНажата" tag="Сохранить карточку"/>
          <button id="btnPlan" label="Отметить по плану" onAction="ЛентаНажата" tag="Отметить выполнение по плану"/>
        </group>

        <group id="grpZamery" label="Замеры и приборы">
          <button id="btnVvod" label="Ввести замеры" onAction="ЛентаНажата" tag="Ввести замеры"/>
          <button id="btnAEvvod" label="Настройки АЭ" onAction="ЛентаНажата" tag="Настройки АЭ"/>
          <button id="btnPokazat" label="Показать замеры записи" onAction="ЛентаНажата" tag="Показать замеры записи"/>
          <button id="btnAE" label="Скопировать настройки АЭ" onAction="ЛентаНажата" tag="Скопировать настройки АЭ"/>
          <button id="btnSredstva" label="Добавить применённые средства" onAction="ЛентаНажата" tag="Добавить применённые средства"/>
          <button id="btnKomplekt" label="Проверить комплект" onAction="ЛентаНажата" tag="Проверить комплект приборов"/>
        </group>

        <group id="grpDoc" label="Документы">
          <button id="btnSformirovat" label="Сформировать документы" onAction="ЛентаНажата" tag="Сформировать документы"/>
          <button id="btnRegistr" label="Зарегистрировать" onAction="ЛентаНажата" tag="Зарегистрировать запись"/>
          <button id="btnPaket" label="Напечатать пакет" onAction="ЛентаНажата" tag="Напечатать пакет"/>
          <button id="btnChernoviki" label="Зарегистрировать все черновики" onAction="ЛентаНажата" tag="Зарегистрировать все черновики"/>
          <button id="btnAnnul" label="Аннулировать заключение" onAction="ЛентаНажата" tag="Аннулировать заключение"/>
          <button id="btnKD" label="Создать корректирующее действие" onAction="ЛентаНажата" tag="Создать корректирующее действие"/>
        </group>

        <group id="grpPechat" label="Печать">
          <button id="btnPoverka" label="Свидетельства о поверке" onAction="ЛентаНажата" tag="Печать свидетельств о поверке"/>
          <button id="btnUdost" label="Удостоверения" onAction="ЛентаНажата" tag="Печать удостоверений"/>
          <button id="btnZhurnaly" label="Печатные журналы" onAction="ЛентаНажата" tag="Построить печатные журналы"/>
          <button id="btnElektro" label="Журнал электроинструмента" onAction="ЛентаНажата" tag="Печать журнала электроинструмента"/>
        </group>

        <group id="grpOborud" label="Оборудование">
          <button id="btnVydat" label="Выдать" onAction="ЛентаНажата" tag="Выдать оборудование"/>
          <button id="btnVozvrat" label="Принять возврат" onAction="ЛентаНажата" tag="Принять возврат"/>
          <button id="btnVydachaPo" label="Выдача по применённым" onAction="ЛентаНажата" tag="Отметить выдачу по применённым"/>
          <button id="btnTO" label="План-график ТО на месяц" onAction="ЛентаНажата" tag="План-график ТО на месяц"/>
          <button id="btnZayavka" label="Заявка на поверку на год" onAction="ЛентаНажата" tag="Заявка на поверку на год"/>
        </group>

        <group id="grpOtchet" label="Отчёты и год">
          <button id="btnOtchetPlan" label="План и внеплановые" onAction="ЛентаНажата" tag="Отчёт: план и внеплановые"/>
          <button id="btnPasport" label="Собрать Паспорт ЛНК" onAction="ЛентаНажата" tag="Собрать Паспорт ЛНК"/>
          <button id="btnZakrytGod" label="Закрыть год" onAction="ЛентаНажата" tag="Закрыть год"/>
          <button id="btnArhiv" label="Передать в архив" onAction="ЛентаНажата" tag="Отметить передачу в архив"/>
          <button id="btnOpis" label="Опись хранения" onAction="ЛентаНажата" tag="Опись хранения"/>
          <button id="btnPyatiletka" label="Пересчитать пятилетний план" onAction="ЛентаНажата" tag="Пересчитать пятилетний план"/>
        </group>

        <group id="grpSM" label="Документы СМ">
          <button id="btnNomerSM" label="Выдать номер документа СМ" onAction="ЛентаНажата" tag="Выдать номер документа СМ"/>
          <button id="btnOznak" label="Лист ознакомления" onAction="ЛентаНажата" tag="Лист ознакомления"/>
        </group>

        <group id="grpObmen" label="Обмен и копии">
          <button id="btnOtpravit" label="Отправить мои изменения" onAction="ЛентаНажата" tag="Отправить мои изменения"/>
          <button id="btnSvod" label="Собрать свод" onAction="ЛентаНажата" tag="Собрать свод"/>
          <button id="btnPoluchit" label="Получить свод" onAction="ЛентаНажата" tag="Получить свод"/>
          <button id="btnFleshka" label="Подготовить флешку" onAction="ЛентаНажата" tag="Подготовить флешку для обмена"/>
          <button id="btnNositel" label="Зарегистрировать носитель" onAction="ЛентаНажата" tag="Зарегистрировать носитель"/>
          <button id="btnKopiya" label="Сделать резервную копию" onAction="ЛентаНажата" tag="Сделать резервную копию"/>
        </group>

        <group id="grpPult" label="Пульт">
          <button id="btnPult" label="Обновить пульт" onAction="ЛентаНажата" tag="Обновить пульт"/>
          <button id="btnObnovlenie" label="Проверить обновление" onAction="ЛентаНажата" tag="Проверить обновление"/>
        </group>

      </tab>
    </tabs>
  </ribbon>
</customUI>
