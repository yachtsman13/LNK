Private Function —проситьѕапку() As String
    Dim по”молчанию As String
    Dim папка As String

    по”молчанию = ThisWorkbook.Path
    If Right$(по”молчанию, 1) <> Application.PathSeparator Then _
        по”молчанию = по”молчанию & Application.PathSeparator
    по”молчанию = по”молчанию & "ƒл€_импорта"

    Do
        папка = InputBox("ѕапка с модул€ми (ƒл€_импорта):", "”становка", по”молчанию)
        If StrPtr(папка) = 0 Then Exit Function        ' нажали Ђќтменаї
        папка = Trim$(папка)
        If папка = "" Then Exit Function
        If Right$(папка, 1) <> Application.PathSeparator Then папка = папка & Application.PathSeparator
        If Dir(папка & "*.bas") = "" Then
            MsgBox "¬ этой папке нет ни одного .bas файла:" & vbCrLf & папка & vbCrLf & vbCrLf & _
                   "”кажите папку Ђƒл€_импортаї из присланного архива Ч тот же файл, " & _
                   "который вы только что импортировали, лежит там же.", _
                   vbExclamation, "”становка"
        Else
            —проситьѕапку = папка
            Exit Function
        End If
    Loop
End Function


' »мпортирует все *.bas из папки, кроме себ€ самого Ч трогать во врем€
' исполнени€ модуль, из которого пр€мо сейчас выполн€етс€ код, нельз€,
' это не проверка вежливости, а гарантированный сбой.
'
' ≈сли модуль с таким именем уже есть в книге, он сперва удал€етс€:
' так же можно накатить обновление модулей после правок, не разбира€
' руками, что именно изменилось Ч Excel не даЄт Ђперезаписатьї модуль
' импортом, только удалить старый и поставить новый.
Private Function »мпортироватьћодули(папка As String, ByRef импортировано As Long, _
                                     ByRef пропущено As Long) As String
    Dim файлы As New Collection
    Dim файл As String
    Dim им€ As String
    Dim ошибки As String
    Dim компонент As Object
    Dim i As Long

    ' —начала полностью собрать список файлов и только потом его
    ' обрабатывать. Dir хранит состо€ние перебора сам в себе: раньше
    ' весь цикл был одним Do While с Dir на входе и на выходе, а внутри
    ' Ч вызовы VBComponents.Import/Remove. ѕр€мых доказательств, что эти
    ' вызовы Dir не трогают, у мен€ нет Ч € не могу здесь запустить
    ' Excel и проверить. –аз нельз€ проверить Ч не полагаемс€: список
    ' собираетс€ одним отдельным циклом Dir, а COM-вызовы идут по уже
    ' готовому списку, без единого Dir поблизости.
    файл = Dir(папка & "*.bas")
    Do While файл <> ""
        файлы.Add файл
        файл = Dir
    Loop

    For i = 1 To файлы.Count
        файл = CStr(файлы(i))
        им€ = Left$(файл, Len(файл) - 4)
        If StrComp(им€, —јћ_—≈Ѕя, vbTextCompare) <> 0 Then
            On Error Resume Next
            Set компонент = ThisWorkbook.VBProject.VBComponents(им€)
            If Not компонент Is Nothing Then
                ThisWorkbook.VBProject.VBComponents.Remove компонент
            End If
            Set компонент = Nothing
            Err.Clear

            ThisWorkbook.VBProject.VBComponents.Import папка & файл
            If Err.Number = 0 Then
                импортировано = импортировано + 1
            Else
                пропущено = пропущено + 1
                ошибки = ошибки & vbCrLf & "  " & файл & ": " & Err.Description
                Err.Clear
            End If
            On Error GoTo 0
        End If
    Next i

    If ошибки <> "" Then »мпортироватьћодули = "Ќе импортировались:" & ошибки
End Function


