Attribute VB_Name = "modUI"
Option Explicit

' ═══════════════════════════════════════════════════════════════════════
'  Лента и правая кнопка мыши: те же команды, что на пульте, но под
'  рукой на любом листе.
'
'  Всё сводится к одному месту — modMenu.ЗапуститьПунктМеню: и кнопка на
'  пульте, и кнопка на ленте, и пункт правой кнопки передают ей один и
'  тот же текст команды. Поэтому список команд один, а не три, и
'  расходиться им негде.
'
'  Лента описана не здесь, а в customUI/customUI14.xml внутри книги
'  программы — VBA ленту создавать не умеет, её кладут в файл снаружи
'  (scripts/inject_ribbon.py). Отсюда только обработчик нажатий.
'
'  Правая кнопка собирается при открытии книги и убирается при закрытии.
'  Само подменю добавляется Temporary — Excel уберёт его сам, даже если
'  книгу закроют аварийно; пункты уходят вместе с ним.
' ═══════════════════════════════════════════════════════════════════════

' Своё имя вместо msoControlPopup: число то же, а зависимость от
' библиотеки Office здесь не нужна — так же, как в modPackage сделано с
' константами Word. Для самих пунктов константа не нужна вовсе: у Add
' тип по умолчанию и есть обычная кнопка.
'
' Шаг сборки держится на уровне модуля: его выставляет и ПостроитьМеню,
' и ДобавитьПункт, а читает обработчик ошибки. Без этого в сообщении
' было бы «добавление пунктов» без указания, на каком именно.
Private Const ПОДМЕНЮ As Long = 10

Private mШаг As String

Private Const ИМЯ_ПОДМЕНЮ As String = "ЛНК"
Private Const МЕНЮ_ЯЧЕЙКИ As String = "Cell"


' ── Лента ─────────────────────────────────────────────────────────────

' Обработчик всех кнопок ленты. Команда лежит в атрибуте tag кнопки —
' тем же текстом, что подпись кнопки на пульте.
'
' IRibbonControl — из библиотеки Office, она подключена в любом проекте
' Excel по умолчанию. Если вдруг окажется, что нет, книга не соберётся с
' ошибкой «User-defined type not defined» именно на этой строке.
' Ошибки перехватываются и здесь, хотя дальше, в ЗапуститьПунктМеню,
' стоит общий перехват. Эти несколько строк до него — единственное, что
' осталось без прикрытия: сбой на них вывел бы окно VBA с кнопкой
' «Debug», а её нажатие ставит проект на паузу, после которой не
' работает уже ничего.
Public Sub ЛентаНажата(control As IRibbonControl)
    Dim команда As String

    On Error GoTo Сбой
    команда = Trim$(CStr(control.Tag))
    If команда = "" Then
        MsgBox "У этой кнопки ленты не задана команда.", vbExclamation, "Лента ЛНК"
        Exit Sub
    End If
    modMenu.ЗапуститьПунктМеню команда
    Exit Sub

Сбой:
    MsgBox "Кнопку ленты не удалось разобрать." & vbCrLf & vbCrLf & _
           "Ошибка " & Err.Number & ": " & Err.Description, _
           vbExclamation, "Лента ЛНК"
End Sub


' ── Правая кнопка мыши ────────────────────────────────────────────────

' Одно подменю «ЛНК» в меню ячейки — вместо полутора десятков пунктов
' вперемешку с «Вырезать» и «Вставить». Внутри — то, что нажимают каждый
' день; редкое (закрытие года, поверка, паспорт) остаётся на пульте и
' на ленте, чтобы список не разрастался.
' Подменю ставится В КОНЕЦ меню ячейки, а не в начало: наверху лежат
' «Вырезать», «Копировать», «Вставить» — то, что рука находит не глядя,
' и сдвигать их нельзя.
'
' Ошибки здесь НЕ глушатся. В первой версии стоял общий On Error Resume
' Next, и когда пункты не добавились, наружу вышло только пустое
' подменю без единого намёка на причину. Молчаливый сбой хуже громкого.
Public Sub ПостроитьМенюПоПравойКнопке()
    Dim меню As Object
    Dim под As Object
    Dim добавлено As Long
    Dim номер As Long
    Dim причина As String

    УбратьМенюПоПравойКнопке

    On Error GoTo Сбой
    mШаг = "поиск меню ячейки"
    Set меню = Application.CommandBars(МЕНЮ_ЯЧЕЙКИ)
    If меню Is Nothing Then Exit Sub

    ' Аргументы позиционные, без Type:= и Temporary:=. Именованные
    ' аргументы при позднем связывании — единственное, что тут вызывало
    ' подозрение после ошибки 13; проверить это у себя я не могу, а
    ' позиционная запись ничем не хуже. Порядок: Type, Id, Parameter,
    ' Before, Temporary; пропущенные оставлены пустыми.
    ' Тип 10 (подменю) здесь передать надо — по умолчанию Add делает
    ' кнопку, а нужна именно раскрывающаяся ветка.
    mШаг = "создание подменю «" & ИМЯ_ПОДМЕНЮ & "»"
    Set под = меню.Controls.Add(ПОДМЕНЮ, , , , True)
    под.Caption = ИМЯ_ПОДМЕНЮ

    mШаг = "добавление пунктов"
    ДобавитьПункт под, "Новая запись в журнале"
    ДобавитьПункт под, "Открыть новый акт"
    ДобавитьПункт под, "Карточка объекта"
    ДобавитьПункт под, "Ввести замеры", True
    ДобавитьПункт под, "Добавить применённые средства"
    ДобавитьПункт под, "Проверить комплект приборов"
    ДобавитьПункт под, "Сформировать документы", True
    ДобавитьПункт под, "Зарегистрировать запись"
    ДобавитьПункт под, "Напечатать пакет"
    ДобавитьПункт под, "Создать корректирующее действие", True
    ДобавитьПункт под, "Аннулировать заключение"
    ДобавитьПункт под, "Выдать оборудование", True
    ДобавитьПункт под, "Принять возврат"
    ДобавитьПункт под, "Обновить пульт", True

    добавлено = под.Controls.Count
    If добавлено = 0 Then
        MsgBox "Подменю «ЛНК» по правой кнопке создалось, но ни один пункт " & _
               "в него не встал." & vbCrLf & vbCrLf & _
               "Само меню при этом работает: те же команды есть на ленте и " & _
               "на пульте." & vbCrLf & vbCrLf & _
               "Скажите мне, что видите это сообщение — буду знать, что дело " & _
               "не в ошибке, а в том, как Excel принимает пункты подменю.", _
               vbExclamation, "Меню правой кнопки"
    End If
    Exit Sub

Сбой:
    ' Номер и текст ошибки снимаются ПЕРВЫМИ: любая следующая команда
    ' On Error очищает Err, и в сообщение попал бы ноль вместо причины.
    номер = Err.Number
    причина = Err.Description

    ' Сколько пунктов успело встать — по самому подменю, а не по
    ' счётчику: до счётчика выполнение могло и не дойти.
    добавлено = -1
    On Error Resume Next
    добавлено = под.Controls.Count
    On Error GoTo 0

    MsgBox "Не удалось собрать подменю «ЛНК» по правой кнопке." & vbCrLf & vbCrLf & _
           "Ошибка " & номер & ": " & причина & vbCrLf & _
           "На чём споткнулось: " & mШаг & vbCrLf & _
           "Пунктов успело встать: " & IIf(добавлено < 0, "подменю не создалось", _
                                           CStr(добавлено)) & vbCrLf & vbCrLf & _
           "Пришлите этот текст. Лента и пульт при этом работают — " & _
           "без правой кнопки система не останавливается.", _
           vbExclamation, "Меню правой кнопки"
End Sub


' Add вызывается БЕЗ единого аргумента. Тип по умолчанию у него — как
' раз обычная кнопка, а значит спорить не о чем: ни имени аргумента, ни
' его типа в вызове просто нет.
'
' Путь к этому был такой. Версия 2.0: пункты не встали, наружу вышло
' пустое подменю без объяснений (общий On Error Resume Next). Версия
' 2.1: я снял с пунктов Temporary, решив, что дело в нём, и — что
' оказалось важнее — добавил сообщение об ошибке. Оно показало номер 13,
' «несовпадение типов», причём само подменю создавалось: спотыкались
' именно пункты. Отсюда и решение — не угадывать, какой аргумент не
' нравится Excel, а не передавать ни одного.
' Аргумент называется «ветка», а не «подменю», хотя подменю и есть:
' рядом лежит константа ПОДМЕНЮ, и редактор VBA приводит имена, которые
' различаются только регистром, к одному написанию — на экране константа
' превращается в «подменю» и выглядит переменной. Ошибкой это не будет,
' но читать такой код нельзя.
Private Sub ДобавитьПункт(ветка As Object, команда As String, _
                          Optional ЧертойВыше As Boolean = False)
    Dim пункт As Object
    mШаг = "пункт «" & команда & "»"
    Set пункт = ветка.Controls.Add
    пункт.Caption = команда
    пункт.OnAction = "'" & ThisWorkbook.Name & "'!ПунктМенюНажат"
    пункт.BeginGroup = ЧертойВыше
End Sub


' Что нажали, узнаём по подписи самого пункта: она и есть команда.
' Отдельного справочника не нужно — расходиться нечему.
Public Sub ПунктМенюНажат()
    Dim пункт As Object
    Dim команда As String

    On Error Resume Next
    Set пункт = Application.CommandBars.ActionControl
    On Error GoTo 0
    If пункт Is Nothing Then Exit Sub

    команда = Trim$(CStr(пункт.Caption))
    If команда <> "" Then modMenu.ЗапуститьПунктМеню команда
End Sub


Public Sub УбратьМенюПоПравойКнопке()
    Dim i As Long
    Dim меню As Object

    On Error Resume Next
    Set меню = Application.CommandBars(МЕНЮ_ЯЧЕЙКИ)
    If меню Is Nothing Then Exit Sub
    For i = меню.Controls.Count To 1 Step -1
        If меню.Controls(i).Caption = ИМЯ_ПОДМЕНЮ Then меню.Controls(i).Delete
    Next i
End Sub
