                        ") Ч вставьте руками (»Ќ—“–” ÷»я, шаг 3, способ второй)."
End Function


' ќбычное посимвольное чтение, без FileSystemObject: файл в cp1251,
' и OpenЕInput читает его в кодировке по умолчанию дл€ системы Ч той
' же самой, в которой редактор VBA читает импортируемые .bas. “ак у
' вставленного текста и у импортированных модулей одна судьба: либо
' оба читаютс€ верно, либо оба одинаково нет, и причина видна сразу.
Private Function ѕрочитать‘айл(путь As String) As String
    Dim n As Integer
    Dim строка As String
    Dim текст As String

    On Error GoTo —бой
    n = FreeFile
    Open путь For Input As #n
    Do While Not EOF(n)
        Line Input #n, строка
        текст = текст & строка & vbCrLf
    Loop
    Close #n
    ѕрочитать‘айл = текст
    Exit Function

—бой:
    On Error Resume Next
    Close #n
    ѕрочитать‘айл = ""
End Function
