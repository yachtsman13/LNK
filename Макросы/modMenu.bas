' ── Отрисовка ─────────────────────────────────────────────────────────

Private Function Раздел(ws As Worksheet, r As Long, текст As String) As Long
    r = r + 1
    ws.Cells(r, 2).Value = текст
    With ws.Range(ws.Cells(r, 2), ws.Cells(r, 4))
        .Interior.Color = RGB(31, 56, 100)
        .Font.Color = RGB(255, 255, 255)
        .Font.Bold = True
    End With
    ws.Rows(r).RowHeight = 20
    Раздел = r + 1
End Function


Private Function Кнопка(ws As Worksheet, r As Long, текст As String, _
                        подсказка As String) As Long
    ПоложитьКнопку ws, r, текст, ПРЕФИКС_КНОПКИ & текст
    ws.Cells(r, 3).Value = подсказка
    ws.Cells(r, 3).Font.Color = RGB(89, 89, 89)
    ws.Cells(r, 3).Font.Italic = True
    ws.Rows(r).RowHeight = В_СТРОКИ
    Кнопка = r + 1
End Function


' Кнопка, которая просто открывает лист. Отдельная от Кнопка, потому
' что листов много, а заводить на каждый ветвь в обработчике — плодить
' строки, которые ничего не решают: имя листа само себе команда.
Private Function КнопкаЛиста(ws As Worksheet, r As Long, текст As String, _
                             лист As String, подсказка As String) As Long
    ПоложитьКнопку ws, r, текст, ПРЕФИКС_ЛИСТА & лист
    ws.Cells(r, 3).Value = подсказка
    ws.Cells(r, 3).Font.Color = RGB(89, 89, 89)
    ws.Cells(r, 3).Font.Italic = True
    ws.Rows(r).RowHeight = В_СТРОКИ
    КнопкаЛиста = r + 1
End Function


Private Sub ПоложитьКнопку(ws As Worksheet, r As Long, надпись As String, имя As String)
    Dim кн As Object
    Dim ячейка As Range

    ws.Rows(r).RowHeight = В_СТРОКИ
    Set ячейка = ws.Cells(r, 2)
    Set кн = ws.Buttons.Add(ячейка.Left + 1, ячейка.Top + 1, _
                            ячейка.Width - 2, ячейка.Height - 2)
    кн.Caption = надпись
    кн.Name = имя
    кн.OnAction = "ЗапуститьКнопку"
    кн.Font.Size = 9
End Sub


Private Function ПересоздатьПульт() As Worksheet
    Dim ws As Worksheet
    On Error Resume Next
    Application.DisplayAlerts = False
    ThisWorkbook.Worksheets(Л_ПУЛЬТ).Delete
    Application.DisplayAlerts = True
    On Error GoTo 0
    Set ws = ThisWorkbook.Worksheets.Add(Before:=ThisWorkbook.Worksheets(1))
    ws.Name = Л_ПУЛЬТ
    ws.Tab.Color = RGB(31, 56, 100)
    ws.Cells.Interior.Color = RGB(255, 255, 255)
    ws.Cells.Font.Name = "Calibri"
    ws.Activate
    ActiveWindow.DisplayGridlines = False
    Set ПересоздатьПульт = ws
End Function


' ── Что нажали ────────────────────────────────────────────────────────

' Обработчик один на все кнопки: какая нажата, кнопка говорит своим
' именем. Имя задаётся при отрисовке и содержит либо команду, либо
' имя листа — разбирать надписи с их пробелами и переносами не надо.
Public Sub ЗапуститьКнопку()
    Dim имя As String

    On Error Resume Next
    имя = CStr(Application.Caller)
    On Error GoTo 0
    If имя = "" Then Exit Sub

    If Left$(имя, Len(ПРЕФИКС_ЛИСТА)) = ПРЕФИКС_ЛИСТА Then
        ОткрытьЛист Mid$(имя, Len(ПРЕФИКС_ЛИСТА) + 1)
    ElseIf Left$(имя, Len(ПРЕФИКС_КНОПКИ)) = ПРЕФИКС_КНОПКИ Then
        ЗапуститьПунктМеню Mid$(имя, Len(ПРЕФИКС_КНОПКИ) + 1)
    End If
End Sub


Private Sub ОткрытьЛист(имяЛиста As String)
    Dim ws As Worksheet
    Set ws = Лист(имяЛиста)
    If ws Is Nothing Then Exit Sub
    ws.Parent.Activate
    ws.Activate
    ws.Range("A4").Select
End Sub


Public Sub ЗапуститьПунктМеню(текст As String)
    Dim имя As String
    имя = Replace(Replace(текст, "»", ""), Chr(160), " ")
    имя = Trim$(имя)

    Select Case имя
        Case "Обновить пульт": modMenu.ПостроитьПульт
        Case "Новая запись в журнале": modJournal.НоваяЗапись
        Case "Открыть новый акт": modJournal.ОткрытьНовыйАкт
        Case "Добавить точки замеров": modMeasure.ДобавитьТочкиЗамеров
        Case "Показать замеры записи": modMeasure.ПоказатьЗамерыЗаписи
        Case "Скопировать настройки АЭ": modMeasure.СкопироватьНастройкиАЭ
        Case "Добавить применённые средства": modKit.ДобавитьПрименённыеСИ
        Case "Проверить комплект приборов": modKit.ПроверитьКомплектСтроки
        Case "Отметить выполнение по плану": modPlan.ОтметитьВыполнениеПоПлану
        Case "Отчёт: план и внеплановые": modPlan.ОтчётПланИВнеплановые
        Case "Карточка объекта": modCard.ОткрытьКарточкуОбъекта
        Case "Сохранить карточку": modCard.СохранитьКарточкуОбъекта
        Case "Зарегистрировать запись": modJournal.ЗарегистрироватьЗапись
        Case "Сформировать документы": modGenerate.СформироватьДокументы
        Case "Аннулировать заключение": modJournal.АннулироватьЗапись
        Case "Построить печатные журналы": modPrintJournals.ПостроитьВсеПечатныеЖурналы
        Case "Сделать резервную копию": modBackup.СделатьЛокальнуюКопию
        Case "Пересчитать счётчики по журналу": modBackup.ВосстановитьСчётчикиИзЖурнала
        Case "Отправить мои изменения": modExchange.ОтправитьМоиИзменения
        Case "Собрать свод": modExchange.СобратьСвод
        Case "Получить свод": modExchange.ПолучитьСвод
        Case "Взять роль мастера на себя": modExchange.ВзятьРольМастера
        Case "Зарегистрировать носитель": modMedia.ЗарегистрироватьНоситель
        Case "Подготовить флешку для обмена": modMedia.ПодготовитьФлешку
        Case "Зарегистрировать все черновики": modJournal.ЗарегистрироватьВсеЧерновики
        Case "План-график ТО на месяц": modPPR.ПостроитьМесячныйПлан
        Case "Заявка на поверку на год": modPPR.ЗаявкаНаПоверку
        Case "Пересчитать пятилетний план": modPPR.ПересчитатьПятилетний
        Case "Собрать Паспорт ЛНК": modPassport.СобратьПаспорт
        Case "Напечатать пакет": modPackage.НапечататьПакет
        Case "Печать свидетельств о поверке": modScans.НапечататьСвидетельстваПоверки
        Case "Печать удостоверений": modScans.НапечататьУдостоверения
        Case "Выдать оборудование": modIssue.ВыдатьОборудование
        Case "Принять возврат": modIssue.ПринятьВозврат
        Case "Отметить выдачу по применённым": modIssue.ОтметитьВыдачуПоЗаписи
        Case "Закрыть год": modYearEnd.ЗакрытьГод
        Case "Печать журнала электроинструмента": modElectro.ПостроитьЖурналЭлектроинструмента
        Case "Проверить обновление": modUpdate.ПроверитьОбновление False
        Case "Опубликовать версию": modUpdate.ОпубликоватьВерсию
    End Select
End Sub
