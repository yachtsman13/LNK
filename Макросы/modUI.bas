Attribute VB_Name = "modUI"
Option Explicit

' ═══════════════════════════════════════════════════════════════════════
'  Лента и правая кнопка мыши: те же команды, что на пульте, но под
'  рукой на любом листе.
'
'  Всё сводится к одному месту — modMenu.ЗапуститьПунктМеню: и кнопка на
'  пульте, и кнопка на ленте, и пункт правой кнопки передают ей один и
'  тот же текст команды. Поэтому список команд один, а не три, и
'  расходиться им негде.
'
'  Лента описана не здесь, а в customUI/customUI14.xml внутри книги
'  программы — VBA ленту создавать не умеет, её кладут в файл снаружи
'  (scripts/inject_ribbon.py). Отсюда только обработчик нажатий.
'
'  Правая кнопка собирается при открытии книги и убирается при закрытии.
'  Пункты добавляются Temporary — Excel уберёт их сам, даже если книгу
'  закроют аварийно: иначе меню обрастает хвостами от прошлых запусков.
' ═══════════════════════════════════════════════════════════════════════

' Свои имена вместо msoControlPopup и msoControlButton: числа те же, а
' зависимость от библиотеки Office здесь не нужна — так же, как в
' modPackage сделано с константами Word.
Private Const ПОДМЕНЮ As Long = 10
Private Const ПУНКТ As Long = 1

Private Const ИМЯ_ПОДМЕНЮ As String = "ЛНК"
Private Const МЕНЮ_ЯЧЕЙКИ As String = "Cell"


' ── Лента ─────────────────────────────────────────────────────────────

' Обработчик всех кнопок ленты. Команда лежит в атрибуте tag кнопки —
' тем же текстом, что подпись кнопки на пульте.
'
' IRibbonControl — из библиотеки Office, она подключена в любом проекте
' Excel по умолчанию. Если вдруг окажется, что нет, книга не соберётся с
' ошибкой «User-defined type not defined» именно на этой строке.
Public Sub ЛентаНажата(control As IRibbonControl)
    Dim команда As String
    команда = Trim$(CStr(control.Tag))
    If команда = "" Then
        MsgBox "У этой кнопки ленты не задана команда.", vbExclamation, "Лента ЛНК"
        Exit Sub
    End If
    modMenu.ЗапуститьПунктМеню команда
End Sub


' ── Правая кнопка мыши ────────────────────────────────────────────────

' Одно подменю «ЛНК» в меню ячейки — вместо полутора десятков пунктов
' вперемешку с «Вырезать» и «Вставить». Внутри — то, что нажимают каждый
' день; редкое (закрытие года, поверка, паспорт) остаётся на пульте и
' на ленте, чтобы список не разрастался.
Public Sub ПостроитьМенюПоПравойКнопке()
    Dim меню As Object
    Dim под As Object

    On Error Resume Next
    УбратьМенюПоПравойКнопке

    Set меню = Application.CommandBars(МЕНЮ_ЯЧЕЙКИ)
    If меню Is Nothing Then Exit Sub

    Set под = меню.Controls.Add(Type:=ПОДМЕНЮ, Before:=1, Temporary:=True)
    под.Caption = ИМЯ_ПОДМЕНЮ

    ДобавитьПункт под, "Новая запись в журнале"
    ДобавитьПункт под, "Открыть новый акт"
    ДобавитьПункт под, "Карточка объекта"
    ДобавитьПункт под, "Добавить точки замеров", True
    ДобавитьПункт под, "Добавить применённые средства"
    ДобавитьПункт под, "Проверить комплект приборов"
    ДобавитьПункт под, "Сформировать документы", True
    ДобавитьПункт под, "Зарегистрировать запись"
    ДобавитьПункт под, "Напечатать пакет"
    ДобавитьПункт под, "Создать корректирующее действие", True
    ДобавитьПункт под, "Аннулировать заключение"
    ДобавитьПункт под, "Выдать оборудование", True
    ДобавитьПункт под, "Принять возврат"
    ДобавитьПункт под, "Обновить пульт", True
End Sub


Private Sub ДобавитьПункт(подменю As Object, команда As String, _
                          Optional ЧертойВыше As Boolean = False)
    Dim пункт As Object
    Set пункт = подменю.Controls.Add(Type:=ПУНКТ, Temporary:=True)
    пункт.Caption = команда
    пункт.OnAction = "'" & ThisWorkbook.Name & "'!ПунктМенюНажат"
    пункт.BeginGroup = ЧертойВыше
End Sub


' Что нажали, узнаём по подписи самого пункта: она и есть команда.
' Отдельного справочника не нужно — расходиться нечему.
Public Sub ПунктМенюНажат()
    Dim пункт As Object
    Dim команда As String

    On Error Resume Next
    Set пункт = Application.CommandBars.ActionControl
    On Error GoTo 0
    If пункт Is Nothing Then Exit Sub

    команда = Trim$(CStr(пункт.Caption))
    If команда <> "" Then modMenu.ЗапуститьПунктМеню команда
End Sub


Public Sub УбратьМенюПоПравойКнопке()
    Dim i As Long
    Dim меню As Object

    On Error Resume Next
    Set меню = Application.CommandBars(МЕНЮ_ЯЧЕЙКИ)
    If меню Is Nothing Then Exit Sub
    For i = меню.Controls.Count To 1 Step -1
        If меню.Controls(i).Caption = ИМЯ_ПОДМЕНЮ Then меню.Controls(i).Delete
    Next i
End Sub
