Attribute VB_Name = "modMenu"
Option Explicit

' ═══════════════════════════════════════════════════════════════════════
'  Пульт: единственный лист, с которого начинается работа.
'
'  Наверху — плитки: что просрочено, что истекает, что ждёт сборки.
'  Ниже — кнопки. Раньше это были два листа и двойной щелчок по строке
'  меню; двойной щелчок приходилось объяснять каждому новому человеку,
'  а Дашборд на отдельном листе смотрели по случаю.
'
'  Кнопки — элементы управления формы, а не ActiveX: они переживают
'  копирование книги между машинами и не требуют ни ссылок, ни
'  регистрации библиотек. Что нажали, кнопка сообщает своим именем
'  через Application.Caller, поэтому обработчик один на все.
' ═══════════════════════════════════════════════════════════════════════

Private Const Л_ПУЛЬТ As String = "Меню"
Private Const ПРЕФИКС_КНОПКИ As String = "КН "
Private Const ПРЕФИКС_ЛИСТА As String = "ЛИСТ "

Private Const Ш_КНОПКИ As Long = 30      ' ширина колонки B, знаков
Private Const В_СТРОКИ As Long = 21      ' высота строки под кнопку, пунктов


Public Sub ПостроитьПульт()
    Dim ws As Worksheet
    Dim r As Long

    Application.ScreenUpdating = False
    On Error GoTo Сбой
    Set ws = ПересоздатьПульт()

    ws.Range("B2").Value = "ЛАБОРАТОРИЯ НЕРАЗРУШАЮЩЕГО КОНТРОЛЯ"
    ws.Range("B3").Value = "Рабочее место " & КодРабочегоМеста() & _
                           IIf(ТекущийСотрудник() = "", "", " · " & ТекущийСотрудник()) & _
                           IIf(ЭтоМастер(), " · мастер", "") & _
                           " · обмен: " & ОписаниеОбмена() & _
                           " · " & Format$(Date, "dd.mm.yyyy")
    ws.Range("B2").Font.Size = 18
    ws.Range("B2").Font.Bold = True
    ws.Range("B2").Font.Color = RGB(31, 56, 100)
    ws.Range("B3").Font.Italic = True
    ws.Range("B3").Font.Color = RGB(89, 89, 89)

    ' Сначала плитки — их число меняется день ото дня, поэтому кнопки
    ' начинаются с той строки, где плитки кончились.
    r = modDashboard.ПлиткиНа(ws, 5)
    r = r + 1
    r = Кнопки(ws, r)

    ws.Columns("A").ColumnWidth = 2
    ws.Columns("B").ColumnWidth = Ш_КНОПКИ
    ws.Columns("C").ColumnWidth = 12
    ws.Columns("D").ColumnWidth = 70
    ws.Activate
    ws.Range("A1").Select
    Application.ScreenUpdating = True
    Exit Sub

Сбой:
    Application.ScreenUpdating = True
    MsgBox "Не удалось построить пульт." & vbCrLf & "Ошибка: " & Err.Description, _
           vbCritical, "Пульт"
End Sub


